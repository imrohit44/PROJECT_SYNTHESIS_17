  "cards": [
    { "dot": "cyan", "title": "One real run", "items": ["rule_score 0.8 from the LARGE_TRANSACTION rule (amount above 10,000)", "ml_probability 0.9890 from fraud-model-v1, above the 0.86 threshold", "combined 0.8756, then a capped graph bonus of 0.15, final score 1.0 HIGH"] },
    { "dot": "amber", "title": "Signals that cannot run wild", "items": ["Rules are deterministic and unit tested one threshold at a time", "The graph contribution is min(0.15, 0.25 x graph_score), so relationships can never dominate", "A missing graph or model degrades the score signal, never the committed transfer"] },
    { "dot": "emerald", "title": "Why the pipeline is shaped this way", "items": ["Scoring reads a committed event, so it can be replayed and recomputed", "Each consumer group owns one job, so a slow scorer cannot delay the ledger", "Every assessment is stored beside the score inputs that produced it"] }

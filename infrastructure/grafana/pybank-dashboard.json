        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pybank-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket{job=~\"banking|fraud\"}[5m])))",
          "legendFormat": "{{service}}"
        }

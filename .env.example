APP_NAME=PyBank
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://pybank:pybank@localhost:5432/pybank
PYBANK_TEST_DATABASE_URL=postgresql+psycopg://pybank_test:pybank_test@localhost:5432/pybank_test
JWT_SECRET=replace-with-a-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MIN_LENGTH=8
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
FRONTEND_ORIGIN=http://localhost:5173

# Docker Compose development defaults.
# Inside Compose, backend reaches PostgreSQL through the service name `postgres`.
# The browser still reaches the backend through a host address such as localhost.
POSTGRES_DB=pybank_docker
POSTGRES_USER=pybank
POSTGRES_PASSWORD=replace-with-a-local-docker-password
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
RUN_MIGRATIONS=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
PYBANK_DEBUG=false
REDIS_URL=redis://localhost:6379/0
REDIS_TEST_URL=redis://localhost:6379/15
CACHE_ENABLED=true
CUSTOMER_CACHE_TTL_SECONDS=300
ACCOUNT_CACHE_TTL_SECONDS=60
ACCOUNT_LIST_CACHE_TTL_SECONDS=60
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=pybank
KAFKA_CONSUMER_GROUP=pybank-audit-consumer

# Fraud service (Phase 10-12) defaults.
FRAUD_HOST_PORT=8001
FRAUD_DATABASE_URL=postgresql+psycopg://pybank:pybank_docker_password@postgres:5432/pybank_fraud
KAFKA_CONSUMER_GROUP_FRAUD=pybank-fraud-consumer
ML_RULE_WEIGHT=0.6
ML_ML_WEIGHT=0.4

# Neo4j graph analysis (Phase 13).
# Neo4j is an analytical read model for relationships, never the ledger.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-neo4j-password
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
GRAPH_ENABLED=true
GRAPH_LOOKBACK_HOURS=24
GRAPH_WEIGHT=0.25
GRAPH_MAX_ADJUSTMENT=0.15

# Phase 14: read-only banking assistant (bounded tool-calling LLM agent).
# The assistant is optional. With no LLM_PROVIDER/LLM_API_KEY the assistant
# endpoints return 503 while the rest of the banking API is unaffected.
# Prompts and versioning live in backend/app/assistant/prompts.py.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=512
# Hard ceiling on model tool rounds per user message.
LLM_MAX_TOOL_CALLS=3
ASSISTANT_MAX_INPUT_CHARS=2000
ASSISTANT_RATE_LIMIT=10
ASSISTANT_RATE_WINDOW_SECONDS=60
# Fraud service endpoint used by the get_fraud_assessment tool.
FRAUD_SERVICE_URL=http://fraud:8000
FRAUD_SERVICE_TIMEOUT_SECONDS=5

# Phase 15: real-time WebSocket delivery + optional outbound WhatsApp.
# WebSocket auth uses the existing JWT access token (query parameter).
# WhatsApp is OUTBOUND-ONLY and OPTIONAL; with WHATSAPP_ENABLED=false the
# banking API and WebSocket delivery are unaffected. Never commit credentials.
REALTIME_CONSUMER_GROUP=pybank-realtime-consumer
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SENDER_ID=
WHATSAPP_TIMEOUT_SECONDS=5


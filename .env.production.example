# PyBank PRODUCTION environment (Phase 16).
#
# Copy to `.env` on the deployment host and fill in real values:
#     cp .env.production.example .env
# `.env` is gitignored and must never be committed.
#
# The development equivalent is `.env.example`. This file exists because
# production has a strictly larger set of REQUIRED secrets and must not be
# started at all if any of them is missing -- docker-compose.prod.yml uses
# `${VAR:?message}` so Compose fails fast with a clear message instead of
# silently falling back to a development default.
#
# ---------------------------------------------------------------- REQUIRED --
# Compose refuses to start the production stack if any of these is unset.

# Signing key for every JWT the banking service issues. Generate with:
#     openssl rand -hex 32
# Rotating it invalidates all existing sessions and WebSocket tickets.
JWT_SECRET=<set-in-production-generate-with-openssl-rand-hex-32>

# Public origin the browser loads the SPA from, including scheme. It is also
# the single CORS allow-list entry. Must match the real deployed domain,
# e.g. https://pybank.example.com
FRONTEND_ORIGIN=<set-in-production-https://your-domain>

# Password for the banking + fraud PostgreSQL server. The same value is shared
# by both databases, which live in the same PostgreSQL instance.
POSTGRES_PASSWORD=<set-in-production>

# Password for the Neo4j fraud graph, used by both services.
NEO4J_PASSWORD=<set-in-production>

# Grafana admin password. Grafana is private (no published port) in
# production, so this is reached through an SSH tunnel, but it is still
# required and must not be a default.
GRAFANA_ADMIN_PASSWORD=<set-in-production>

# ---------------------------------------------------------------- OPTIONAL --
# Every value below has a working default in docker-compose.prod.yml. They are
# listed so the operator can see and override them deliberately.

# production is the only supported value for a real deployment.
APP_ENV=production

# DEBUG, rate-limit and log verbosity.
LOG_LEVEL=INFO

# Set automatically by deploy/deploy.sh to the commit SHA being released, so
# a running service can always be traced back to an exact commit.
APP_VERSION=0.1.0

# Explicit CORS allow-list. Leave EMPTY in production: the SPA and the API are
# served from the same origin through Nginx, so cross-origin access is not
# needed and a wildcard would be a real security regression. Only set this if
# a separate dashboard origin genuinely needs access.
CORS_ALLOW_ORIGINS=

# Grafana login name.
GRAFANA_ADMIN_USER=admin

# Loopback ports the host Nginx proxies to. Change only if the host already
# uses these ports. They are bound to 127.0.0.1 and are never public.
BACKEND_BIND_PORT=8000
FRONTEND_BIND_PORT=8080

# --------------------------------------------------------- RELEASE IMAGES --
# Do NOT set these by hand. deploy/deploy.sh writes them on every deployment
# with the immutable commit SHA it is releasing, and rollback.sh rewrites them
# with the SHA being restored. They are shown here only so their purpose is
# documented.
#
#   PYBANK_BACKEND_IMAGE=ghcr.io/imrohit44/pybank-backend:<commit-sha>
#   PYBANK_FRAUD_IMAGE=ghcr.io/imrohit44/pybank-fraud:<commit-sha>
#   PYBANK_FRONTEND_IMAGE=ghcr.io/imrohit44/pybank-frontend:<commit-sha>

# ------------------------------------------------------------------ SECRETS --
# These are consumed by compose.yaml / the application and must also be set on
# the host if the corresponding service is enabled. Phase 16 does not require
# them, so they are commented out rather than given fake defaults:
#
#   LLM_API_KEY / LLM_PROVIDER        Phase 14 read-only assistant
#   WHATSAPP_*                        Phase 15 outbound adapter
#   REDIS_PASSWORD                    only if Redis auth is enabled
#
# Never place a real secret in this file. It is committed to git.
